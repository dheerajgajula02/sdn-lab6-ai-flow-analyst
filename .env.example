# ==============================================================================
# SDN AI Flow Analyst - Environment Configuration Template
# Copy this file to .env and replace the placeholder values below.
# DO NOT commit .env with real credentials to version control!
# ==============================================================================

# LLM API Configuration (OpenAI-compatible endpoints: MiMo, OpenAI, DeepSeek, etc.)
MIMO_API_KEY=your_llm_api_key_here
MIMO_BASE_URL=https://token-plan-sgp.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.6-flash

# MongoDB Telemetry Storage URI (with 24h TTL)
MONGO_URI=mongodb://username:password@hostname:27017/?authSource=admin
MONGO_DB=sdn_lab6
MONGO_COLL=telemetry

# Remote MCP Server SSE Endpoint (Optional)
MCP_SERVER_URL=http://localhost:8090/sse

# SDN Controller REST Endpoint
CONTROLLER_IP=10.224.78.132
CONTROLLER_PORT=8080

# Mininet VM SSH Configuration
MININET_HOST=10.224.76.126
MININET_USER=mininet
MININET_PASS=mininet
